<UserControl x:Class="WinOpti.UI.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinOpti.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <DataTemplate x:Key="CleanRow">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,1,16,0"/>
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <Border Background="{StaticResource CardAlt}" CornerRadius="6" Padding="8,2" Visibility="{Binding NeedsAdminVisible, Converter={StaticResource Vis}}">
                                <TextBlock Text="{ui:Tr 'нужны права администратора', En='needs administrator rights'}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="19"/>
                        <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasResult, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right"
                               Foreground="{Binding SizeBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
        <StackPanel Margin="40,0,40,40" MaxWidth="1100">
            <TextBlock Text="{ui:Tr 'Очистка диска', En='Disk cleanup'}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{ui:Tr 'Удаляем только то, что Windows и программы создают заново сами. Файлы, которые сейчас заняты, пропускаем.', En='We only delete what Windows and apps recreate on their own. Files that are in use are skipped.'}"
                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TotalCaption" Text="{ui:Tr 'Можно освободить', En='Can be freed'}" FontSize="13" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="Total" Text="…" FontFamily="{StaticResource NumFont}" FontSize="44" FontWeight="Bold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Summary" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <Grid x:Name="Progress" Margin="0,14,32,0" Visibility="Collapsed">
                            <Border x:Name="Track" Height="6" CornerRadius="3" Background="{StaticResource CardAlt}"/>
                            <Border x:Name="Fill" Height="6" CornerRadius="3" Background="{StaticResource Accent}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="FillScale" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="CleanButton" Style="{StaticResource AccentButton}" Click="OnClean" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CleanIcon" Text="&#xE74D;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource OnAccent}" FontSize="13" Margin="0,1,9,0"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><RotateTransform x:Name="Spin"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="CleanText" Text="{ui:Tr 'Очистить выбранное', En='Clean selected'}" Foreground="{StaticResource OnAccent}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RescanButton" Style="{StaticResource GhostButton}" Content="{ui:Tr 'Проверить снова', En='Check again'}" Click="OnRescan" Margin="0,10,0,0" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="AdminBanner" Background="{StaticResource OrangeSoft}" CornerRadius="16" Padding="16,12" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Orange}" FontSize="14" Margin="0,1,10,0"/>
                    <TextBlock Text="{ui:Tr 'Часть пунктов чистится только с правами администратора. Запусти WinOpti от имени администратора, чтобы почистить всё.', En='Some items need administrator rights. Run WinOpti as administrator to clean everything.'}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="List" ItemTemplate="{StaticResource CleanRow}" Margin="0,18,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
