<Window x:Class="WinOpti.UI.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinOpti.UI"
        Title="WinOpti" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Card}"
        BorderBrush="{StaticResource Line}" BorderThickness="1" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Окно ошибки: без прозрачности и теней, как и главное. Перетаскивается за любое место. -->
    <StackPanel Margin="30,26,30,26">
        <TextBlock x:Name="Heading" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{ui:Tr 'Если хочешь, чтобы это исправили, отправь отчёт. В нём только версия WinOpti, Windows, модель железа и текст ошибки — ничего личного.', En='If you want this fixed, send the report. It only has the WinOpti and Windows versions, your hardware model and the error text — nothing personal.'}"
                   FontSize="13.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>

        <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,18,0,0">
            <TextBox x:Name="ReportText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Muted}"
                     FontFamily="Consolas" FontSize="11.5" Padding="12,10" MaxHeight="170" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" CaretBrush="{StaticResource Text}"/>
        </Border>

        <WrapPanel Margin="0,20,0,0">
            <Button x:Name="CopyButton" Style="{StaticResource SmallAccentButton}" Click="OnCopy" Margin="0,0,10,0">
                <TextBlock x:Name="CopyText" Foreground="{StaticResource OnAccent}" Text="{ui:Tr 'Скопировать отчёт', En='Copy report'}"/>
            </Button>
            <Button Style="{StaticResource GhostButton}" Click="OnGitHub" Margin="0,0,10,0" Content="{ui:Tr 'Сообщить на GitHub', En='Report on GitHub'}"/>
            <Button Style="{StaticResource GhostButton}" Click="OnClose" Content="{ui:Tr 'Закрыть', En='Close'}"/>
        </WrapPanel>
    </StackPanel>
</Window>
