<UserControl x:Class="WinOpti.UI.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinOpti.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <DataTemplate x:Key="TweakCard">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14"
                    Padding="20,16" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border Background="{Binding RiskSoft}" CornerRadius="6" Padding="8,2" Margin="0,2,6,2">
                                <TextBlock Text="{Binding RiskText}" Foreground="{Binding RiskBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#2A1F10" CornerRadius="6" Padding="8,2" Margin="0,2,6,2" Visibility="{Binding IsPartial, Converter={StaticResource Vis}}">
                                <TextBlock Text="{ui:Tr 'частично', En='partly'}" Foreground="{StaticResource Orange}" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource CardAlt}" CornerRadius="6" Padding="8,2" Margin="0,2,6,2" Visibility="{Binding Unsupported, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding UnsupportedText}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="19"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasAfter, Converter={StaticResource Vis}}">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,7,0"/>
                            <TextBlock Text="{Binding After}" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="{Binding HasMessage, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="…" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource Switch}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
        <StackPanel Margin="40,0,40,40" MaxWidth="1100">
            <TextBlock Text="{ui:Tr 'Твики Windows', En='Windows tweaks'}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="Subtitle" Text="{ui:Tr 'Убирают фоновую нагрузку и задержки. Любой можно выключить — вернутся настройки, которые были до WinOpti.', En='They cut background load and delays. Turn any off and the settings from before WinOpti come back.'}"
                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <Border x:Name="AdminBanner" Background="{StaticResource OrangeSoft}" CornerRadius="16" Padding="16,12" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Orange}" FontSize="14" Margin="0,1,10,0"/>
                    <TextBlock Text="{ui:Tr 'Чтобы менять настройки, запусти WinOpti от имени администратора. Сейчас можно только посмотреть.', En='Run WinOpti as administrator to change settings. Right now you can only look.'}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardAlt}" CornerRadius="11" Padding="4" HorizontalAlignment="Left" Margin="0,20,0,14">
                <WrapPanel x:Name="Categories"/>
            </Border>

            <Grid Margin="0,0,0,12">
                <TextBlock x:Name="Status" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="2,0,280,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="{ui:Tr 'Поиск твиков', En='Search tweaks'}" Width="260" Height="36" HorizontalAlignment="Right" TextChanged="OnSearch"/>
            </Grid>
            <ItemsControl x:Name="List" ItemTemplate="{StaticResource TweakCard}"/>
            <TextBlock x:Name="Empty" Text="{ui:Tr 'Ничего не нашли. Попробуй другое слово.', En='Nothing found. Try another word.'}" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
