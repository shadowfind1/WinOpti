<UserControl x:Class="WinOpti.UI.FpsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <!-- переключатель длительности: таблетки -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="8" Padding="14,7" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1C2026"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RunRow">
            <Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Game}" FontSize="14" FontWeight="SemiBold"/>
                            <Border Background="{Binding LabelBrush}" CornerRadius="6" Padding="7,1" Margin="10,0,0,0"
                                    Visibility="{Binding HasLabel, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{Binding LabelForeground}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Avg}" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="средний FPS" FontSize="11" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Low1}" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="1% low" FontSize="11" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Stutters}" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="фризов" FontSize="11" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="До" Command="{Binding MarkBefore}" Padding="12,6" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="После" Command="{Binding MarkAfter}" Padding="12,6" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding Delete}" Padding="10,6" ToolTip="Удалить">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
        <StackPanel Margin="40,0,40,40" MaxWidth="1100">
            <TextBlock Text="Замер FPS до и после" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Замерь игру до исправлений и после — и увидь реальный прирост на своём ПК, а не обещания."
                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <!-- запуск замера -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,24,0,0">
                <Grid>
                    <!-- подготовка -->
                    <Grid x:Name="SetupPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Как замерить" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="23" Margin="0,8,24,0">
                                1. Нажми «Начать» и спокойно запускай игру — ждать будем сколько нужно.<LineBreak/>
                                2. Замер начнётся сам, когда игра откроется на весь экран. Играй как обычно, в конце прозвучит сигнал.<LineBreak/>
                                3. Исправь найденное в «Диагностике» и замерь ещё раз в том же месте игры.
                            </TextBlock>
                            <TextBlock Text="Игра в окне? Разверни её на весь экран или включи режим «без рамки» — так WinOpti поймёт, что пора мерить." FontSize="12"
                                       Foreground="{StaticResource Dim}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="230">
                            <TextBlock Text="Длительность" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource CardAlt}" CornerRadius="10" Padding="4" Margin="0,8,0,14" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="D30" Style="{StaticResource Pill}" GroupName="dur" Content="30 с"/>
                                    <RadioButton x:Name="D60" Style="{StaticResource Pill}" GroupName="dur" Content="60 с" IsChecked="True"/>
                                    <RadioButton x:Name="D120" Style="{StaticResource Pill}" GroupName="dur" Content="2 мин"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Проходов" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource CardAlt}" CornerRadius="10" Padding="4" Margin="0,8,0,14" HorizontalAlignment="Center"
                                    ToolTip="Три прохода подряд: итог точнее, и видно, насколько стабильны цифры">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="P1" Style="{StaticResource Pill}" GroupName="passes" Content="1"/>
                                    <RadioButton x:Name="P3" Style="{StaticResource Pill}" GroupName="passes" Content="3 — точнее" IsChecked="True"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Click="OnStart">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource OnAccent}" FontSize="13" Margin="0,1,9,0"/>
                                    <TextBlock Text="Начать замер" Foreground="{StaticResource OnAccent}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- идёт замер -->
                    <Grid x:Name="RunPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Timer" Text="10" FontFamily="{StaticResource NumFont}" FontSize="64" FontWeight="Bold"
                                   MinWidth="120" TextAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Phase" Text="Заходи в игру" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PhaseText" FontSize="13.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="0,14,0,0" Height="4" x:Name="RunTrack">
                                <Border Background="#1C2026" CornerRadius="2"/>
                                <Border x:Name="RunFill" Background="{StaticResource AccentGradient}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Отменить" Click="OnCancel" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock x:Name="Message" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Red}" TextWrapping="Wrap"
                       Margin="4,12,0,0" Visibility="Collapsed"/>

            <!-- кто мешал игре -->
            <Border x:Name="ThievesPanel" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="28,24" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ThievesTitle" Text="Что мешало игре" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ThievesSub" FontSize="12.5" Foreground="{StaticResource Dim}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ThievesList" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,20,0,0">
                        <Button x:Name="FixAllButton" Style="{StaticResource SmallAccentButton}" Click="OnFixAllAndRetest" Margin="0,0,10,0">
                            <TextBlock x:Name="FixAllText" Text="Исправить всё и замерить снова" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                        <Button x:Name="RetestButton" Style="{StaticResource GhostButton}" Content="Замерить снова" Click="OnStart" Padding="16,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="FixAllResult" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- твой ПК против похожих -->
            <Border x:Name="CommunityPanel" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="28,24" Margin="0,18,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Твой ПК против похожих" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CommunityText" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>
                        <TextBlock x:Name="CommunityNote" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button x:Name="CommunityButton" Grid.Column="1" Style="{StaticResource SmallAccentButton}" Click="OnCommunityConsent" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock Text="Сравнить с похожими ПК" Foreground="{StaticResource OnAccent}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- сравнение -->
            <Border x:Name="ComparePanel" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="28,24" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="CompareTitle" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CompareSub" FontSize="12.5" Foreground="{StaticResource Dim}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="ShareButton" Style="{StaticResource SmallAccentButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnShare">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource OnAccent}" FontSize="13" Margin="0,1,8,0"/>
                                <TextBlock Text="Картинка результата" Foreground="{StaticResource OnAccent}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <UniformGrid x:Name="CompareGrid" Columns="4" Margin="0,20,0,0"/>
                    <TextBlock x:Name="ShareResult" FontSize="12.5" Foreground="{StaticResource Green}" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- история -->
            <TextBlock x:Name="HistoryHeader" Text="Замеры" FontSize="18" FontWeight="SemiBold" Margin="2,28,0,12"/>
            <ItemsControl x:Name="History" ItemTemplate="{StaticResource RunRow}"/>
            <TextBlock x:Name="HistoryEmpty" Text="Замеров пока нет. Сделай первый — это займёт минуту."
                       FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
