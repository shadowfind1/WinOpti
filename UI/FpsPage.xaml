<UserControl x:Class="WinOpti.UI.FpsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinOpti.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <!-- переключатель длительности: таблетки -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="8" Padding="14,7" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A2233"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RunRow">
            <Border Background="{StaticResource Card}" CornerRadius="16" Padding="16,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Game}" FontSize="14" FontWeight="SemiBold"/>
                            <Border Background="{Binding LabelBrush}" CornerRadius="6" Padding="7,1" Margin="10,0,0,0"
                                    Visibility="{Binding HasLabel, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{Binding LabelForeground}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Avg}" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="{ui:Tr 'средний FPS', En='average FPS'}" FontSize="11" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Low1}" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="1% low" FontSize="11" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Stutters}" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="{ui:Tr 'фризов', En='stutters'}" FontSize="11" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{ui:Tr 'До', En='Before'}" Command="{Binding MarkBefore}" Padding="12,6" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="{ui:Tr 'После', En='After'}" Command="{Binding MarkAfter}" Padding="12,6" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding Delete}" Padding="10,6" ToolTip="{ui:Tr 'Удалить', En='Delete'}">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
        <StackPanel Margin="40,0,40,40" MaxWidth="1100">
            <TextBlock Text="{ui:Tr 'Замер FPS до и после', En='FPS test, before and after'}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{ui:Tr 'Замерь игру до исправлений и после — и увидь реальный прирост на своём ПК, а не обещания.', En='Test your game before and after the fixes and see the real gain on your own PC, not promises.'}"
                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <!-- запуск замера -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,24,0,0">
                <Grid>
                    <!-- подготовка -->
                    <Grid x:Name="SetupPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{ui:Tr 'Как замерить', En='How to test'}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="23" Margin="0,8,24,0"
                                       Text="{ui:Tr '1. Нажми «Начать» и спокойно запускай игру — ждать будем сколько нужно.&#10;2. Замер начнётся сам, когда игра откроется на весь экран. Играй как обычно, в конце прозвучит сигнал.&#10;3. Исправь найденное в «Диагностике» и замерь ещё раз в том же месте игры.', En='1. Press Start and launch your game, no rush: we’ll wait as long as needed.&#10;2. The test starts by itself when the game goes fullscreen. Play as usual; a beep marks the end.&#10;3. Fix what Diagnostics found and test again at the same spot in the game.'}"/>
                            <TextBlock Text="{ui:Tr 'Игра в окне? Разверни её на весь экран или включи режим «без рамки» — так WinOpti поймёт, что пора мерить.', En='Game in a window? Make it fullscreen or borderless so WinOpti knows it’s time to measure.'}" FontSize="12"
                                       Foreground="{StaticResource Dim}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="230">
                            <TextBlock Text="{ui:Tr 'Длительность', En='Duration'}" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource CardAlt}" CornerRadius="14" Padding="4" Margin="0,8,0,14" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="D30" Style="{StaticResource Pill}" GroupName="dur" Content="{ui:Tr '30 с', En='30 s'}"/>
                                    <RadioButton x:Name="D60" Style="{StaticResource Pill}" GroupName="dur" Content="{ui:Tr '60 с', En='60 s'}" IsChecked="True"/>
                                    <RadioButton x:Name="D120" Style="{StaticResource Pill}" GroupName="dur" Content="{ui:Tr '2 мин', En='2 min'}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{ui:Tr 'Проходов', En='Passes'}" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource CardAlt}" CornerRadius="14" Padding="4" Margin="0,8,0,14" HorizontalAlignment="Center"
                                    ToolTip="{ui:Tr 'Три прохода подряд: итог точнее, и видно, насколько стабильны цифры', En='Three passes in a row: a more accurate result, and you see how stable the numbers are'}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="P1" Style="{StaticResource Pill}" GroupName="passes" Content="1"/>
                                    <RadioButton x:Name="P3" Style="{StaticResource Pill}" GroupName="passes" Content="{ui:Tr '3 — точнее', En='3 · more accurate'}" IsChecked="True"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Click="OnStart">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource OnAccent}" FontSize="13" Margin="0,1,9,0"/>
                                    <TextBlock Text="{ui:Tr 'Начать замер', En='Start test'}" Foreground="{StaticResource OnAccent}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- идёт замер -->
                    <Grid x:Name="RunPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Timer" Text="10" FontFamily="{StaticResource NumFont}" FontSize="64" FontWeight="Bold"
                                   MinWidth="120" TextAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Phase" Text="{ui:Tr 'Заходи в игру', En='Launch your game'}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PhaseText" FontSize="13.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="0,14,0,0" Height="4" x:Name="RunTrack">
                                <Border Background="#1A2233" CornerRadius="2"/>
                                <Border x:Name="RunFill" Background="{StaticResource AccentGradient}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{ui:Tr 'Отменить', En='Cancel'}" Click="OnCancel" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock x:Name="Message" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Red}" TextWrapping="Wrap"
                       Margin="4,12,0,0" Visibility="Collapsed"/>

            <!-- кто мешал игре -->
            <Border x:Name="ThievesPanel" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="16" Padding="28,24" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ThievesTitle" Text="{ui:Tr 'Что мешало игре', En='What hurt your game'}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ThievesSub" FontSize="12.5" Foreground="{StaticResource Dim}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ThievesList" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,20,0,0">
                        <Button x:Name="FixAllButton" Style="{StaticResource SmallAccentButton}" Click="OnFixAllAndRetest" Margin="0,0,10,0">
                            <TextBlock x:Name="FixAllText" Text="{ui:Tr 'Исправить всё и замерить снова', En='Fix all and test again'}" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                        <Button x:Name="RetestButton" Style="{StaticResource GhostButton}" Content="{ui:Tr 'Замерить снова', En='Test again'}" Click="OnStart" Padding="16,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="FixAllResult" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- твой ПК против похожих -->
            <Border x:Name="CommunityPanel" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="16" Padding="28,24" Margin="0,18,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{ui:Tr 'Твой ПК против похожих', En='Your PC vs similar PCs'}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CommunityText" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>
                        <TextBlock x:Name="CommunityNote" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button x:Name="CommunityButton" Grid.Column="1" Style="{StaticResource SmallAccentButton}" Click="OnCommunityConsent" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock Text="{ui:Tr 'Сравнить с похожими ПК', En='Compare with similar PCs'}" Foreground="{StaticResource OnAccent}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- сравнение -->
            <Border x:Name="ComparePanel" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="16" Padding="28,24" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="CompareTitle" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CompareSub" FontSize="12.5" Foreground="{StaticResource Dim}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="ShareButton" Style="{StaticResource SmallAccentButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnShare">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource OnAccent}" FontSize="13" Margin="0,1,8,0"/>
                                <TextBlock Text="{ui:Tr 'Картинка результата', En='Result image'}" Foreground="{StaticResource OnAccent}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <UniformGrid x:Name="CompareGrid" Columns="4" Margin="0,20,0,0"/>
                    <TextBlock x:Name="ShareResult" FontSize="12.5" Foreground="{StaticResource Green}" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- история -->
            <TextBlock x:Name="HistoryHeader" Text="{ui:Tr 'Замеры', En='Runs'}" FontSize="18" FontWeight="SemiBold" Margin="2,28,0,12"/>
            <ItemsControl x:Name="History" ItemTemplate="{StaticResource RunRow}"/>
            <TextBlock x:Name="HistoryEmpty" Text="{ui:Tr 'Замеров пока нет. Сделай первый — это займёт минуту.', En='No runs yet. Make your first one, it takes a minute.'}"
                       FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
