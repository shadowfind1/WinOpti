<UserControl x:Class="WinOpti.UI.ChecksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinOpti.UI">
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
        <StackPanel Margin="40,0,40,40" MaxWidth="1100">
            <TextBlock Text="{ui:Tr 'Проверки', En='Checks'}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{ui:Tr 'Игровой режим и то, что влияет на игру, но в настройках Windows не видно: мышь, сеть, видеокарта и её драйвер.', En='Game mode and things that affect your game but aren’t visible in Windows settings: mouse, network, GPU and its driver.'}"
                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <!-- авто-игровой режим -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="16" Background="{StaticResource AccentGradient}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <WrapPanel>
                                <TextBlock Text="{ui:Tr 'Авто-игровой режим', En='Auto game mode'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <Border x:Name="GameModeChip" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource CardAlt}">
                                    <TextBlock x:Name="GameModeState" Text="…" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="{ui:Tr 'Когда запускаешь игру, WinOpti сам включает максимальную производительность, ставит на паузу индексацию поиска и понижает приоритет фоновых программ — браузеров, облаков и тех, что мешали игре в твоих замерах. Ничего не закрывает. Закрыл игру — всё вернулось как было.', En='When you launch a game, WinOpti switches to maximum performance, pauses search indexing and lowers the priority of background apps: browsers, cloud sync and whatever hurt your game in your tests. Nothing gets closed. Quit the game and everything goes back to how it was.'}"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="{ui:Tr 'Работает тихо в фоне: проверяет раз в 2 секунды, открыта ли игра, и почти не тратит ресурсы. Запускается вместе с Windows.', En='Runs quietly in the background: checks every 2 seconds whether a game is open and uses almost no resources. Starts with Windows.'}"/>
                        </StackPanel>
                        <Button x:Name="GameModeButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnGameMode" VerticalAlignment="Top" IsEnabled="False">
                            <TextBlock x:Name="GameModeButtonText" Text="{ui:Tr 'Включить', En='Turn on'}" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="GameModeMessage" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- мышь -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="16" Background="{StaticResource BlueSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE962;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="{ui:Tr 'Частота опроса мыши', En='Mouse polling rate'}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="{ui:Tr 'Сколько раз в секунду мышь сообщает компьютеру, куда она сдвинулась. Для игр нужно 1000 Гц: при 125 Гц прицел обновляется раз в 8 мс и двигается с задержкой.', En='How many times per second the mouse tells the PC where it moved. Games need 1000 Hz: at 125 Hz the crosshair updates every 8 ms and lags behind.'}"/>
                        </StackPanel>
                        <Button x:Name="MouseButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnMouseTest" VerticalAlignment="Top">
                            <TextBlock x:Name="MouseButtonText" Text="{ui:Tr 'Проверить', En='Test'}" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <Border x:Name="MousePad" Background="{StaticResource CardAlt}" CornerRadius="14" Height="170" Margin="0,20,0,0" Visibility="Collapsed">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="MouseLive" Text="{ui:Tr 'Води мышью быстро кругами', En='Move your mouse fast in circles'}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="MouseHint" Text="{ui:Tr 'Без остановок, 3 секунды движения. Кнопки нажимать не нужно.', En='Don’t stop, 3 seconds of movement. No need to click.'}" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Grid VerticalAlignment="Bottom" Margin="24,0,24,20" Height="5">
                                <Border Background="{StaticResource Line}" CornerRadius="2.5"/>
                                <Border x:Name="MouseFill" Background="{StaticResource Accent}" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="MouseFillScale" ScaleX="0"/></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="MouseResult" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="MouseHz" FontFamily="{StaticResource NumFont}" FontSize="40" FontWeight="Bold"/>
                        <TextBlock x:Name="MouseVerdict" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="20"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- пинг -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="16" Background="{StaticResource GreenSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="{ui:Tr 'Пинг до игровых серверов', En='Ping to game servers'}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="{ui:Tr '15 секунд пингуем ближайшие серверы Valve (через них играют CS2 и Dota 2) и твой роутер. Так видно не только пинг, но и где проблема: в Wi-Fi или у провайдера.', En='For 15 seconds we ping the nearest Valve servers (CS2 and Dota 2 play through them) and your router. That shows not just the ping but where the problem is: Wi-Fi or your ISP.'}"/>
                        </StackPanel>
                        <Button x:Name="PingButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnPingTest" VerticalAlignment="Top">
                            <TextBlock x:Name="PingButtonText" Text="{ui:Tr 'Проверить', En='Test'}" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="PingProgress" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="PingPhase" FontSize="13" Foreground="{StaticResource Muted}"/>
                        <Grid Height="5" Margin="0,10,0,0">
                            <Border Background="{StaticResource Line}" CornerRadius="2.5"/>
                            <Border Background="{StaticResource Accent}" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="PingFillScale" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <Grid x:Name="PingTable" Margin="0,18,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="PingVerdict" FontSize="13.5" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="20" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- видеокарта для игр -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="16" Background="{StaticResource OrangeSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="{ui:Tr 'Видеокарта для игр', En='GPU for games'}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpuSummary" Text="{ui:Tr 'Смотрим видеокарты и игры…', En='Looking at GPUs and games…'}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"/>
                        </StackPanel>
                        <Button x:Name="GpuAllButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnGpuAll" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="GpuAllText" Text="{ui:Tr 'Все игры — на мощную', En='All games on powerful GPU'}" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <Border x:Name="MonitorWarning" Background="{StaticResource RedSoft}" CornerRadius="16" Padding="16,12" Margin="0,16,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Red}" FontSize="14" Margin="0,1,10,0" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="MonitorWarningText" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="GpuGames" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- драйвер AMD -->
            <Border x:Name="AmdCard" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="16" Background="{StaticResource RedSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Red}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="{ui:Tr 'Настройки AMD Radeon', En='AMD Radeon settings'}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AmdSummary" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="{ui:Tr 'Что поставить в AMD Software для игр. Открой его кнопкой справа или клавишами Alt+R прямо в игре, дальше: Игры → Видеокарта (Graphics).', En='What to set in AMD Software for games. Open it with the button on the right or Alt+R in-game, then go to Gaming → Graphics.'}"/>
                        </StackPanel>
                        <Button x:Name="AmdOpen" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnAmdOpen" VerticalAlignment="Top">
                            <TextBlock Text="{ui:Tr 'Открыть AMD Software', En='Open AMD Software'}" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="AmdRows" Margin="0,6,0,0"/>
                    <TextBlock x:Name="AmdMessage" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Orange}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <!-- снимок настроек (только чтение): по двум снимкам разработчик найдёт, где драйвер хранит Anti-Lag и Chill -->
                    <Border Background="{StaticResource CardAlt}" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AmdProbeText" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" Margin="0,0,16,0"
                                       Text="{ui:Tr 'Хочешь, чтобы WinOpti переключал эти настройки сам? Сделай снимок, поменяй Anti-Lag в AMD Software, сделай второй и пришли оба файла разработчику. Снимок только читает настройки.', En='Want WinOpti to switch these by itself? Take a snapshot, change Anti-Lag in AMD Software, take another one and send both files to the developer. The snapshot only reads settings.'}"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="OnAmdProbe" VerticalAlignment="Center" Content="{ui:Tr 'Снимок настроек', En='Take snapshot'}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- драйвер NVIDIA -->
            <Border x:Name="NvCard" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="16" Background="{StaticResource GreenSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{ui:Tr 'Настройки драйвера NVIDIA', En='NVIDIA driver settings'}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="{ui:Tr 'То же, что «Панель управления NVIDIA → Параметры 3D», только без поиска по меню. Меняем глобальные настройки для всех игр.', En='Same as NVIDIA Control Panel → 3D Settings, without digging through menus. We change the global settings for all games.'}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="NvRows" Margin="0,8,0,0"/>
                    <TextBlock x:Name="NvMessage" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
