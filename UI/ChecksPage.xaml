<UserControl x:Class="WinOpti.UI.ChecksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
        <StackPanel Margin="40,0,40,40" MaxWidth="1100">
            <TextBlock Text="Проверки" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Игровой режим и то, что влияет на игру, но в настройках Windows не видно: мышь, сеть, видеокарта и её драйвер."
                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <!-- авто-игровой режим -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentGradient}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <WrapPanel>
                                <TextBlock Text="Авто-игровой режим" FontSize="17" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <Border x:Name="GameModeChip" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource CardAlt}">
                                    <TextBlock x:Name="GameModeState" Text="…" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="Когда запускаешь игру, WinOpti сам включает максимальную производительность, ставит на паузу индексацию поиска и понижает приоритет фоновых программ — браузеров, облаков и тех, что мешали игре в твоих замерах. Ничего не закрывает. Закрыл игру — всё вернулось как было."/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Работает тихо в фоне: проверяет раз в 2 секунды, открыта ли игра, и почти не тратит ресурсы. Запускается вместе с Windows."/>
                        </StackPanel>
                        <Button x:Name="GameModeButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnGameMode" VerticalAlignment="Top" IsEnabled="False">
                            <TextBlock x:Name="GameModeButtonText" Text="Включить" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="GameModeMessage" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- мышь -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource BlueSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE962;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="Частота опроса мыши" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="Сколько раз в секунду мышь сообщает компьютеру, куда она сдвинулась. Для игр нужно 1000 Гц: при 125 Гц прицел обновляется раз в 8 мс и двигается с задержкой."/>
                        </StackPanel>
                        <Button x:Name="MouseButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnMouseTest" VerticalAlignment="Top">
                            <TextBlock x:Name="MouseButtonText" Text="Проверить" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <Border x:Name="MousePad" Background="{StaticResource CardAlt}" CornerRadius="10" Height="170" Margin="0,20,0,0" Visibility="Collapsed">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="MouseLive" Text="Води мышью быстро кругами" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="MouseHint" Text="Без остановок, 3 секунды движения. Кнопки нажимать не нужно." FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Grid VerticalAlignment="Bottom" Margin="24,0,24,20" Height="5">
                                <Border Background="{StaticResource Line}" CornerRadius="2.5"/>
                                <Border x:Name="MouseFill" Background="{StaticResource Accent}" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="MouseFillScale" ScaleX="0"/></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="MouseResult" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="MouseHz" FontFamily="{StaticResource NumFont}" FontSize="40" FontWeight="Bold"/>
                        <TextBlock x:Name="MouseVerdict" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="20"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- пинг -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource GreenSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="Пинг до игровых серверов" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="15 секунд пингуем ближайшие серверы Valve (через них играют CS2 и Dota 2) и твой роутер. Так видно не только пинг, но и где проблема: в Wi-Fi или у провайдера."/>
                        </StackPanel>
                        <Button x:Name="PingButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnPingTest" VerticalAlignment="Top">
                            <TextBlock x:Name="PingButtonText" Text="Проверить" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="PingProgress" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="PingPhase" FontSize="13" Foreground="{StaticResource Muted}"/>
                        <Grid Height="5" Margin="0,10,0,0">
                            <Border Background="{StaticResource Line}" CornerRadius="2.5"/>
                            <Border Background="{StaticResource Accent}" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="PingFillScale" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <Grid x:Name="PingTable" Margin="0,18,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="PingVerdict" FontSize="13.5" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="20" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- видеокарта для игр -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource OrangeSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="Видеокарта для игр" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpuSummary" Text="Смотрим видеокарты и игры…" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"/>
                        </StackPanel>
                        <Button x:Name="GpuAllButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnGpuAll" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="GpuAllText" Text="Все игры — на мощную" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <Border x:Name="MonitorWarning" Background="{StaticResource RedSoft}" CornerRadius="12" Padding="16,12" Margin="0,16,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Red}" FontSize="14" Margin="0,1,10,0" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="MonitorWarningText" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="GpuGames" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- драйвер AMD -->
            <Border x:Name="AmdCard" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource RedSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Red}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="Настройки AMD Radeon" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AmdSummary" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="Что поставить в AMD Software для игр. Открой его кнопкой справа или клавишами Alt+R прямо в игре, дальше: Игры → Видеокарта (Graphics)."/>
                        </StackPanel>
                        <Button x:Name="AmdOpen" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnAmdOpen" VerticalAlignment="Top">
                            <TextBlock Text="Открыть AMD Software" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="AmdRows" Margin="0,6,0,0"/>
                    <TextBlock x:Name="AmdMessage" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Orange}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- драйвер NVIDIA -->
            <Border x:Name="NvCard" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource GreenSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{StaticResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Настройки драйвера NVIDIA" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="То же, что «Панель управления NVIDIA → Параметры 3D», только без поиска по меню. Меняем глобальные настройки для всех игр."/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="NvRows" Margin="0,8,0,0"/>
                    <TextBlock x:Name="NvMessage" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
