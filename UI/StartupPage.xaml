<UserControl x:Class="WinOpti.UI.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <DataTemplate x:Key="StartupRow">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource CardAlt}" VerticalAlignment="Top" Margin="0,0,16,0">
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource Dim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource GreenSoft}" CornerRadius="6" Padding="8,2" Margin="0,2,6,2" Visibility="{Binding CanDisable, Converter={StaticResource Vis}}">
                                <TextBlock Text="можно выключить" Foreground="{StaticResource Green}" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource BlueSoft}" CornerRadius="6" Padding="8,2" Margin="0,2,6,2" Visibility="{Binding ShouldKeep, Converter={StaticResource Vis}}">
                                <TextBlock Text="лучше оставить" Foreground="{StaticResource Blue}" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource RedSoft}" CornerRadius="6" Padding="8,2" Margin="0,2,6,2" Visibility="{Binding Missing, Converter={StaticResource Vis}}">
                                <TextBlock Text="программа удалена" Foreground="{StaticResource Red}" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource CardAlt}" CornerRadius="6" Padding="8,2" Margin="0,2,6,2" Visibility="{Binding NeedsAdminVisible, Converter={StaticResource Vis}}">
                                <TextBlock Text="нужны права администратора" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding HintText}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasHint, Converter={StaticResource Vis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Running, Converter={StaticResource Vis}}">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Green}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Usage}" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="{Binding HasMessage, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="…" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource Switch}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
        <StackPanel Margin="40,0,40,40" MaxWidth="1100">
            <TextBlock Text="Автозагрузка" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Программы, которые запускаются вместе с Windows. Выключение ничего не удаляет — так же, как в Диспетчере задач. Включить обратно можно в любой момент."
                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Запускается вместе с Windows" FontSize="13" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="Total" Text="…" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="Bold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Summary" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="DisableButton" Style="{StaticResource AccentButton}" Click="OnDisableRecommended" IsEnabled="False">
                            <TextBlock x:Name="DisableText" Text="Выключить лишнее" Foreground="{StaticResource OnAccent}"/>
                        </Button>
                        <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}" Content="Обновить" Click="OnRefresh" Margin="0,10,0,0" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="AdminBanner" Background="{StaticResource OrangeSoft}" CornerRadius="12" Padding="16,12" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Orange}" FontSize="14" Margin="0,1,10,0"/>
                    <TextBlock Text="Программы для всех пользователей и задачи планировщика меняются только с правами администратора." FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Warning" FontSize="12.5" Foreground="{StaticResource Orange}" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock x:Name="OnHeader" Text="ВКЛЮЧЕНО" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="4,24,0,10" Visibility="Collapsed"/>
            <ItemsControl x:Name="OnList" ItemTemplate="{StaticResource StartupRow}"/>
            <StackPanel x:Name="SvcHeader" Margin="4,18,0,10" Visibility="Collapsed">
                <TextBlock Text="СЛУЖБЫ" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}"/>
                <TextBlock Text="Работают в фоне с самого включения ПК, ещё до входа в Windows. Выключенная служба переходит в режим «вручную»: если она понадобится своей программе, та запустит её сама."
                           FontSize="12.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <ItemsControl x:Name="SvcList" ItemTemplate="{StaticResource StartupRow}"/>
            <TextBlock x:Name="OffHeader" Text="ВЫКЛЮЧЕНО" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="4,18,0,10" Visibility="Collapsed"/>
            <ItemsControl x:Name="OffList" ItemTemplate="{StaticResource StartupRow}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
