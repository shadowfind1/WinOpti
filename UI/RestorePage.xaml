<UserControl x:Class="WinOpti.UI.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <DataTemplate x:Key="AppliedRow">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasMessage, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="16,7" FontSize="13" Command="{Binding RevertCommand}"
                            IsEnabled="{Binding CanRevert}" Content="{Binding ButtonText}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PointRow">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" FontSize="13" Foreground="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HistoryRow">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" Background="{Binding Soft}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{Binding Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="12" Foreground="{StaticResource Dim}" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
        <StackPanel Margin="40,0,40,40" MaxWidth="1100">
            <TextBlock Text="Восстановление" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Всё, что меняет WinOpti, можно вернуть. Здесь откат твиков, журнал действий и точки восстановления Windows."
                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <Border x:Name="AdminBanner" Background="{StaticResource OrangeSoft}" CornerRadius="12" Padding="16,12" Margin="0,18,0,0" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Orange}" FontSize="14" Margin="0,1,10,0" DockPanel.Dock="Left"/>
                    <TextBlock Text="Откатывать твики и работать с точками восстановления можно только с правами администратора. Сейчас можно только посмотреть." FontSize="13" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- изменения WinOpti -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Изменения WinOpti" FontSize="13" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="AppliedTotal" Text="…" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="Bold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="AppliedSummary" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Откат возвращает ровно те настройки, что были до WinOpti, а не «настройки по умолчанию»."/>
                        </StackPanel>
                        <Button x:Name="RevertAllButton" Grid.Column="1" Style="{StaticResource GhostButton}" Click="OnRevertAll" IsEnabled="False" VerticalAlignment="Center">
                            <TextBlock x:Name="RevertAllText" Text="Откатить всё"/>
                        </Button>
                    </Grid>
                    <Button x:Name="AppliedToggle" Style="{StaticResource GhostButton}" Click="OnAppliedToggle" HorizontalAlignment="Left" Margin="0,16,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="AppliedList" ItemTemplate="{StaticResource AppliedRow}" Margin="0,14,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- точки восстановления -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Точки восстановления Windows" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PointsStatus" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Снимок системных настроек. Если после каких-то изменений Windows работает плохо, можно вернуться к нему — личные файлы не трогаются."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OpenRstrui" Style="{StaticResource GhostButton}" Content="Откатиться к точке…" Click="OnOpenRstrui" Margin="0,0,10,0"/>
                            <Button x:Name="CreatePoint" Style="{StaticResource AccentButton}" Click="OnCreatePoint" IsEnabled="False">
                                <TextBlock x:Name="CreatePointText" Text="Создать точку" Foreground="{StaticResource OnAccent}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="PointsMessage" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="PointsList" ItemTemplate="{StaticResource PointRow}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- журнал -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Журнал" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Что и когда делал WinOpti (обе версии) на этом компьютере." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,16"/>
                    <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryRow}"/>
                    <TextBlock x:Name="HistoryEmpty" Text="Пока пусто." FontSize="13" Foreground="{StaticResource Dim}" Visibility="Collapsed"/>
                    <Button x:Name="HistoryMore" Style="{StaticResource GhostButton}" Content="Показать всё" Click="OnHistoryMore" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
