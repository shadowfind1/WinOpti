<Window x:Class="WinOpti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinOpti.UI"
        Title="WinOpti" Width="1200" Height="780" MinWidth="1060" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Своя рамка окна, но без AllowsTransparency: прозрачное окно в WPF рисуется программно и лагает. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="72" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

        <!-- карточка находки -->
        <DataTemplate x:Key="FindingCard">
            <Border x:Name="card" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="16" Padding="20,18" Margin="0,0,0,12" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="16"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" CornerRadius="11" Background="{Binding TintSoft}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{Binding Tint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" FontSize="13.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Margin="0,5,0,0" LineHeight="20"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Border Background="{Binding TintSoft}" CornerRadius="7" Padding="9,3" Margin="0,0,8,0">
                                <TextBlock Text="{Binding SeverityText}" Foreground="{Binding Tint}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource CardAlt}" CornerRadius="7" Padding="9,3" Margin="0,0,8,0"
                                    Visibility="{Binding HasImpact, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#3BE8FF"
                                               VerticalAlignment="Center" Margin="0,1,6,0"/>
                                    <TextBlock Text="{Binding Impact}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource CardAlt}" CornerRadius="7" Padding="9,3"
                                    Visibility="{Binding NeedsReboot, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding NeedsRebootText}" FontSize="12" Foreground="{StaticResource Muted}"/>
                            </Border>
                        </WrapPanel>
                        <Border Background="{StaticResource CardAlt}" CornerRadius="10" Padding="16,12" Margin="0,14,0,0"
                                Visibility="{Binding GuideOpen, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Guide}" FontSize="13" TextWrapping="Wrap" LineHeight="21"/>
                        </Border>
                        <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBrush}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding HasResult, Converter={StaticResource Vis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" MinWidth="150">
                        <Button Style="{StaticResource SmallAccentButton}" Content="{Binding FixLabel}" Command="{Binding FixCommand}"
                                Visibility="{Binding CanFix, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{ui:Tr 'Исправляю…', En='Fixing…'}" Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,8"
                                   Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8"
                                    Visibility="{Binding Done, Converter={StaticResource Vis}}">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Green}" FontSize="13" Margin="0,2,6,0"/>
                            <TextBlock Text="{ui:Tr 'Исправлено', En='Fixed'}" Foreground="{StaticResource Green}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Content="{Binding GuideButtonText}" Command="{Binding GuideCommand}" Margin="0,8,0,0"
                                Visibility="{Binding ShowGuideButton, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- строка «в порядке» -->
        <DataTemplate x:Key="OkRow">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,10,10" Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource GreenSoft}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Green}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== шапка: логотип, вкладки, язык, кнопки окна ===== -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="32,0,28,0">
                    <Run Text="WIN"/><Run Text="OPTI" Foreground="{StaticResource Accent}"/>
                </TextBlock>

                <!-- WindowChrome.IsHitTestVisibleInChrome наследуется: вкладки в зоне заголовка кликаются -->
                <StackPanel x:Name="Nav" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="diag" IsChecked="True" Checked="OnNav" Content="{ui:Tr 'Диагностика', En='Diagnostics'}"/>
                    <RadioButton x:Name="NavFps" Style="{StaticResource NavItem}" GroupName="nav" Tag="fps" Checked="OnNav" Content="{ui:Tr 'Замер FPS', En='FPS test'}"/>
                    <RadioButton x:Name="NavChecks" Style="{StaticResource NavItem}" GroupName="nav" Tag="checks" Checked="OnNav" Content="{ui:Tr 'Проверки', En='Checks'}"/>
                    <RadioButton x:Name="NavTweaks" Style="{StaticResource NavItem}" GroupName="nav" Tag="tweaks" Checked="OnNav" Content="{ui:Tr 'Твики', En='Tweaks'}"/>
                    <RadioButton x:Name="NavClean" Style="{StaticResource NavItem}" GroupName="nav" Tag="clean" Checked="OnNav" Content="{ui:Tr 'Очистка', En='Cleanup'}"/>
                    <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" GroupName="nav" Tag="startup" Checked="OnNav" Content="{ui:Tr 'Автозагрузка', En='Startup'}"/>
                    <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}" GroupName="nav" Tag="restore" Checked="OnNav" Content="{ui:Tr 'Откат', En='Restore'}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- появляется, только когда на GitHub есть версия новее -->
                    <Button x:Name="UpdateButton" Click="OnUpdate" Visibility="Collapsed" Cursor="Hand" Margin="0,0,10,0" FocusVisualStyle="{x:Null}"
                            ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="60000">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="16" Height="32" Padding="12,0" BorderThickness="1" BorderBrush="{StaticResource Accent}" Background="Transparent">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#0F2A33"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ToolTip>
                            <ToolTip Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" Padding="14,12" MaxWidth="420">
                                <StackPanel>
                                    <TextBlock x:Name="UpdateTitle" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpdateNotes" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <!-- точка прав: подробности во всплывающей подсказке, чтобы не занимать место в шапке -->
                    <Border Background="Transparent" Padding="8" Margin="0,0,6,0" VerticalAlignment="Center" ToolTipService.InitialShowDelay="200">
                        <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{StaticResource Green}"/>
                        <Border.ToolTip>
                            <ToolTip Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock x:Name="AdminText" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SystemText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                    </Border>
                    <Border Background="{StaticResource Card}" CornerRadius="16" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LangRu" Style="{StaticResource FilterPill}" GroupName="lang" Content="RU" FontSize="11.5" Checked="OnLang"/>
                            <RadioButton x:Name="LangEn" Style="{StaticResource FilterPill}" GroupName="lang" Content="EN" FontSize="11.5" Checked="OnLang"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Text="&#xE921;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                    <Button Style="{StaticResource CloseButton}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== контент ===== -->
        <Grid Grid.Row="1" Margin="0,28,0,0">

            <!-- Диагностика: слева оценка, справа что нашли -->
            <Grid x:Name="DiagPage" Margin="40,0,24,0" MaxWidth="1240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="24"
                        Padding="30,28" Margin="0,0,0,28">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{ui:Tr 'ОЦЕНКА ПК', En='PC SCORE'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <ui:ScoreRing x:Name="Ring" DockPanel.Dock="Top" Height="160" Margin="0,14,0,0"/>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                            <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Height="52" Click="OnScan" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource OnAccent}" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{ui:Tr 'ПРОВЕРИТЬ СНОВА', En='CHECK AGAIN'}" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource OnAccent}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnGoFps" Cursor="Hand" HorizontalAlignment="Center" Margin="0,14,0,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="t" Text="{ui:Tr 'Замерить FPS до и после', En='Measure FPS before and after'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="0,22,0,0">
                            <TextBlock x:Name="Verdict" Text="{ui:Tr 'Проверяем ПК…', En='Checking your PC…'}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="Summary" Text="{ui:Tr 'Это займёт пару секунд. Ничего не меняем, только смотрим.', En='Takes a couple of seconds. Nothing is changed, we only look.'}"
                                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21"/>
                            <Grid Margin="0,18,0,0" Height="4" x:Name="ProgressTrack">
                                <Border Background="#1A2233" CornerRadius="2"/>
                                <Border x:Name="ProgressFill" Background="{StaticResource AccentGradient}" CornerRadius="2"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="DiagScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
                    <StackPanel Margin="24,0,16,28">
                        <TextBlock x:Name="ProblemsHeader" Text="{ui:Tr 'Что можно улучшить', En='What can be improved'}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="2,4,0,14" Visibility="Collapsed"/>
                        <ItemsControl x:Name="ProblemsList" ItemTemplate="{StaticResource FindingCard}"/>

                        <TextBlock x:Name="OkHeader" Text="{ui:Tr 'В порядке', En='All good'}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="2,18,0,14" Visibility="Collapsed"/>
                        <ItemsControl x:Name="OkList" ItemTemplate="{StaticResource OkRow}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Замер FPS -->
            <ui:FpsPage x:Name="FpsView" Visibility="Collapsed"/>

            <!-- остальные страницы создаются при первом открытии -->
            <ContentControl x:Name="TweaksView" Visibility="Collapsed" Focusable="False"/>
            <ContentControl x:Name="CleanView" Visibility="Collapsed" Focusable="False"/>
            <ContentControl x:Name="StartupView" Visibility="Collapsed" Focusable="False"/>
            <ContentControl x:Name="RestoreView" Visibility="Collapsed" Focusable="False"/>
            <ContentControl x:Name="ChecksView" Visibility="Collapsed" Focusable="False"/>

        </Grid>
    </Grid>
</Window>
